# Copy to .env. Generate a unique secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORT=4000
JWT_SECRET=
DB_PATH=./data/servicehub.db

# Optional Firebase Admin service-account JSON as a single-line value.
# Keep credentials out of source control. Leave blank to disable push notifications.
FIREBASE_SERVICE_ACCOUNT_JSON=
