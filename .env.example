# Copy to .env (deploy/setup.sh does it for you and fills in the secrets). NEVER commit .env.

# Database password (only used inside the docker network)
DB_PASSWORD=change-me
# >= 32 characters. Changing it logs everybody out.
JWT_SECRET=change-me-to-something-long-and-random-at-least-32-chars

# Address Caddy answers on:
#   your domain (e.g. servis.elgor.rs)  -> automatic HTTPS, ports 80/443 must be forwarded to this PC
#   :80                                 -> plain HTTP (behind a Cloudflare Tunnel, or LAN test)
SITE_ADDRESS=:80
# How phones/browsers reach it, e.g. https://servis.elgor.rs
PUBLIC_URL=http://localhost

# Email of the first admin, created on the very first start (random password printed ONCE in: docker compose logs java)
ADMIN_EMAIL=admin@servicehub.local
# Hourly reminder to technicians with open nalozi: "pick the status" (Spring cron: sec min hour day month weekday; Belgrade time)
REMINDER_CRON="0 0 8-19 * * MON-SAT"
REMINDER_ENABLED=true

# Only for:  docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Where databases and photos live on the host (back this folder up)
DATA_DIR=./data
# Where backup.sh writes (ideally a SECOND disk)
BACKUP_DIR=/mnt/backup/elgor
# Ako je BACKUP_DIR poseban disk: putanja tacke montiranja (npr. /mnt/backup). Backup se prekida ako disk nije montiran.
REQUIRE_MOUNT=
# Optional: copy backups elsewhere too, rsync syntax, e.g. user@host:/path
BACKUP_REMOTE=

# First install ONLY (do not keep it here): ALLOW_NEW_DATABASE=true docker compose up -d --build
# Normally Postgres REFUSES to start when the data folder holds no database (protects against a silent empty database).
