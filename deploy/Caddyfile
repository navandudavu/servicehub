# SITE_ADDRESS comes from .env:
#   moj-domen.rs  -> Caddy gets and renews a Let's Encrypt certificate by itself (needs ports 80+443 reachable)
#   :80           -> plain HTTP (behind a Cloudflare Tunnel, which does the HTTPS, or for a LAN test)
{
	# anything coming from a private address (cloudflared, docker network) may tell us the real client IP
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS:":80"} {
	encode zstd gzip

	# photos from phones (the Java service itself accepts at most 10 MB per photo)
	request_body {
		max_size 15MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# browsers ignore HSTS on plain http, so this is harmless on the LAN test and active behind https
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	# The one backend: accounts, nalozi, customers, parts, photos, reports
	handle /api/* {
		reverse_proxy java:8081
	}

	# React app, with fallback to index.html for client-side routes
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
